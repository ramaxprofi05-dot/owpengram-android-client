<?xml version="1.0" encoding="utf-8"?>
<animated-vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="femboygram_splash"
            android:width="320dp"
            android:height="320dp"
            android:viewportWidth="320"
            android:viewportHeight="320">
            <group
                android:name="brand_mark"
                android:pivotX="160"
                android:pivotY="160"
                android:scaleX="0.82"
                android:scaleY="0.82">
                <path
                    android:fillColor="#B86BFF"
                    android:pathData="M160,42 A118,118 0,1 0,160 278 A118,118 0,1 0,160 42"/>
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M112,98 L211,98 L211,126 L143,126 L143,155 L197,155 L197,184 L143,184 L143,222 L112,222 Z"/>
                <path
                    android:fillColor="#FFFFD6F2"
                    android:pathData="M205,186 C190,168 165,185 205,224 C245,185 220,168 205,186 Z"/>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="brand_mark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:duration="450"
                    android:valueFrom="0.82"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot"/>
                <objectAnimator
                    android:propertyName="scaleY"
                    android:duration="450"
                    android:valueFrom="0.82"
                    android:valueTo="1"
                    android:valueType="floatType"
                    android:interpolator="@android:interpolator/overshoot"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
